<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 系统 SplashWindow 图标：与 CloudTraceEmblemView 的雕塑矢量轮廓 1:1 对齐。

    图层顺序：液态玻璃底 → 右上空气柔光 → 双重交叠渐变波浪 → 云迹丝带 →
    流线雕塑跑者剪影 → 悬浮玻璃泪滴 Pin → 镜面高光描边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288"
    tools:ignore="VectorRaster">

    <group
        android:translateX="96"
        android:translateY="96">

        <clip-path android:pathData="M25,4 L71,4 A21,21 0 0 1 92,25 L92,71 A21,21 0 0 1 71,92 L25,92 A21,21 0 0 1 4,71 L4,25 A21,21 0 0 1 25,4 Z" />

        <!-- 1. 液态玻璃底：天蓝 → 冰青 → 薄荷 -->
        <path android:pathData="M25,4 L71,4 A21,21 0 0 1 92,25 L92,71 A21,21 0 0 1 71,92 L25,92 A21,21 0 0 1 4,71 L4,25 A21,21 0 0 1 25,4 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="4"
                    android:startY="4"
                    android:endX="92"
                    android:endY="92"
                    android:startColor="@color/dr_emblem_shell_top"
                    android:centerColor="@color/dr_emblem_shell_mid"
                    android:endColor="@color/dr_emblem_shell_bottom" />
            </aapt:attr>
        </path>

        <!-- 2. 右上空气柔光 -->
        <path android:pathData="M4,4 L92,4 L92,92 L4,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="78.8"
                    android:centerY="19.8"
                    android:gradientRadius="58"
                    android:startColor="@color/dr_emblem_glow"
                    android:endColor="#00FFFFFF" />
            </aapt:attr>
        </path>

        <!-- 3a. 后层青绿薄荷波浪 -->
        <path android:pathData="M26,92 Q67.4,53.3 92,65.6 L92,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="30"
                    android:startY="61"
                    android:endX="92"
                    android:endY="92"
                    android:startColor="@color/dr_emblem_wave_high"
                    android:endColor="@color/dr_emblem_wave_high_end" />
            </aapt:attr>
        </path>

        <!-- 3b. 前层冰蓝雾白波浪 -->
        <path android:pathData="M4,78.8 Q43.6,62.1 92,86.7 L92,92 L4,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="4"
                    android:startY="72"
                    android:endX="92"
                    android:endY="92"
                    android:startColor="@color/dr_emblem_wave_low"
                    android:endColor="@color/dr_emblem_wave_low_end" />
            </aapt:attr>
        </path>

        <!-- 4. 云迹丝带弧线 -->
        <path
            android:pathData="M32.2,69.1 C60.3,65.6 85.0,51.5 73.5,42.7"
            android:strokeColor="@color/dr_emblem_trail"
            android:strokeWidth="2.1"
            android:strokeLineCap="round" />

        <!-- 5. 雕塑流线跑者剪影（头部 + 整体液态玻璃填充轮廓） -->
        <path android:pathData="M52.0,26.2 A5.5,5.5 0 1 0 52.0,37.2 A5.5,5.5 0 1 0 52.0,26.2 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="17"
                    android:startY="26"
                    android:endX="61"
                    android:endY="76"
                    android:startColor="@color/dr_emblem_runner"
                    android:endColor="@color/dr_emblem_glass_tint_end" />
            </aapt:attr>
        </path>
        <path android:pathData="M23.8,44.0 Q35.2,34.4 49.3,43.2 Q55.5,46.2 61.6,40.1 Q60.8,49.3 48.9,51.1 Q55.9,58.6 48.9,69.6 Q43.2,77.0 38.8,78.8 Q44.5,67.4 42.7,60.3 Q28.6,72.2 14.1,75.7 Q29.1,64.3 38.8,50.2 Q32.6,44.5 23.8,44.0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="17"
                    android:startY="26"
                    android:endX="61"
                    android:endY="76"
                    android:startColor="@color/dr_emblem_runner"
                    android:endColor="@color/dr_emblem_glass_tint_end" />
            </aapt:attr>
        </path>

        <!-- 6. 悬浮镂空玻璃泪滴 Pin -->
        <path
            android:fillType="evenOdd"
            android:pathData="M71.76,41.84 C63.4,32.6 61.64,26.44 61.64,22.48 A10.12,10.12 0 1 1 81.88,22.48 C81.88,26.44 80.12,32.6 71.76,41.84 Z M75.81,22.48 A4.05,4.05 0 1 0 67.71,22.48 A4.05,4.05 0 1 0 75.81,22.48 Z"
            android:strokeColor="#F2FFFFFF"
            android:strokeWidth="0.9">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="63"
                    android:startY="12"
                    android:endX="81"
                    android:endY="42"
                    android:startColor="@color/dr_emblem_pin"
                    android:endColor="@color/dr_emblem_glass_tint_end" />
            </aapt:attr>
        </path>

        <!-- 7. 外框 1.5dp 镜面高光描边 -->
        <path
            android:pathData="M25,4 L71,4 A21,21 0 0 1 92,25 L92,71 A21,21 0 0 1 71,92 L25,92 A21,21 0 0 1 4,71 L4,25 A21,21 0 0 1 25,4 Z"
            android:strokeColor="@color/dr_emblem_shell_rim"
            android:strokeWidth="1.5" />
    </group>
</vector>
