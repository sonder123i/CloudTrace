<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件底板：深海渐变 + 1dp 冰蓝细描边 + 18dp 圆角（RemoteViews 无折射，靠层次表达玻璃） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#F00B1524"
        android:startColor="#F0080E18"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#335CE1E6" />
    <corners android:radius="18dp" />
</shape>
