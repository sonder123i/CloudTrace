<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗次级胶囊按钮：半透凹槽 + 极细边框 + 触摸波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dr_overlay_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dr_overlay_recess" />
            <stroke
                android:width="0.5dp"
                android:color="@color/dr_overlay_tile_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
