<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 收起态：宽度自适应的磨砂迷你药丸。
         外壳用 CapsuleShellView 而不是 FrameLayout：它在子视图画完后叠加边缘流光，
         既不参与测量（不会把胶囊撑大），也天然贴合胶囊矩形。 -->
    <com.zcshou.gogogo.run.ui.overlay.CapsuleShellView
        android:id="@+id/capsuleShell"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/capsuleBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:minWidth="148dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="14dp">

            <com.zcshou.gogogo.run.ui.overlay.RingProgressView
                android:id="@+id/capsuleRing"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/capsuleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="待命"
                android:textColor="@color/dr_overlay_text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.overlay.CapsuleShellView>

    <!-- 展开态：磨砂玻璃控制岛（展开时迷你药丸整体隐藏）。
         同样是 CapsuleShellView：玻璃背景 + 边缘流光都在这块圆角区域上。 -->
    <com.zcshou.gogogo.run.ui.overlay.CapsuleShellView
        android:id="@+id/capsuleActions"
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="11dp">

        <LinearLayout
            android:id="@+id/hubHeader"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/hubDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/hubStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="模拟运行中 · 已接管"
                android:textColor="@color/dr_overlay_text_primary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnHubCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_overlay_round"
                android:contentDescription="收起"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_up"
                android:tint="@color/dr_overlay_text_secondary"
                tools:ignore="UseAppTint" />
        </LinearLayout>

        <!-- 实时遥测行：运动线索 · 海拔 · 精度 · 计步脉搏点（18dp 极克制） -->
        <LinearLayout
            android:id="@+id/capsuleTelemetry"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="1dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/capsuleTelemetryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="稳步巡航 · 海拔 55m · ±6m"
                android:textColor="@color/dr_overlay_text_secondary"
                android:textSize="10sp" />

            <View
                android:id="@+id/capsuleStepDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_dot"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_tile"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配速 · 可调"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPaceMinus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_overlay_recess"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/dr_overlay_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/capsulePace"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/dr_overlay_ice"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPacePlus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_overlay_recess"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/dr_overlay_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_tile"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目标距离 · 可调"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDistMinus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_overlay_recess"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/dr_overlay_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/capsuleLap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:text="3.0km"
                        android:textColor="@color/dr_overlay_ice"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnDistPlus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_overlay_recess"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/dr_overlay_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCapsulePause"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_recess"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="暂停"
                android:textColor="@color/dr_overlay_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCapsuleDetour"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_recess"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="插点"
                android:textColor="@color/dr_overlay_ice"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCapsuleFinish"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_recess"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="收尾"
                android:textColor="@color/dr_overlay_ice"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapsuleManual"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:text="临时手动接管"
            android:textColor="@color/dr_overlay_ice"
            app:backgroundTint="@color/dr_overlay_tonal_bg"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_crosshair"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/dr_overlay_ice"
            app:rippleColor="@color/dr_overlay_ripple"
            app:strokeColor="@color/dr_overlay_tile_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHubStopSim"
            style="@style/Widget.App.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:text="结束定位并关闭"
            app:backgroundTint="@color/dr_overlay_danger_bg"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/dr_overlay_danger"
            app:rippleColor="@color/dr_overlay_ripple" />
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.overlay.CapsuleShellView>

    <!-- 手动接管形态：紧凑战术摇杆（同一套磨砂玻璃 + 流光） -->
    <com.zcshou.gogogo.run.ui.overlay.CapsuleShellView
        android:id="@+id/capsuleRoamPanel"
        android:layout_width="216dp"
        android:layout_height="258dp"
        android:layout_marginTop="6dp"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hubDragBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_more"
                android:drawablePadding="4dp"
                android:drawableTint="@color/dr_overlay_text_secondary"
                android:gravity="center_vertical"
                android:text="拖动位置"
                android:textColor="@color/dr_overlay_text_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btnRoamLock"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_overlay_round"
                android:contentDescription="摇杆锁定"
                android:padding="7dp"
                android:src="@drawable/ic_lock_open_line"
                android:tint="@color/dr_overlay_text_secondary"
                tools:ignore="UseAppTint" />

            <ImageView
                android:id="@+id/btnRoamCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_overlay_round"
                android:contentDescription="收起"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_up"
                android:tint="@color/dr_overlay_text_secondary"
                tools:ignore="UseAppTint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_overlay_tile"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/hubGearWalk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="步"
                android:textColor="@color/dr_overlay_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hubGearJog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_chip_selected"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="跑"
                android:textColor="@color/dr_overlay_ice"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hubGearBike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="骑"
                android:textColor="@color/dr_overlay_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hubGearCar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="车"
                android:textColor="@color/dr_overlay_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.zcshou.gogogo.run.ui.overlay.TacticalJoystickView
            android:id="@+id/hubJoystick"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCapsuleReturn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_chip_selected"
                android:gravity="center"
                android:text="回归跑道"
                android:textColor="@color/dr_overlay_ice"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHubStopSimRoam"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_danger_button"
                android:gravity="center"
                android:text="结束定位"
                android:textColor="@color/dr_overlay_danger"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.overlay.CapsuleShellView>
</LinearLayout>
