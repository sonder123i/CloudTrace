<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pf_canvas">

    <!-- 真实百度地图：与建圈时看到的底图一致 -->
    <com.baidu.mapapi.map.TextureMapView
        android:id="@+id/previewMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部 36dp 渐隐保护层 -->
    <View
        android:id="@+id/previewTopScrim"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <!-- 顶部玻璃信息条：路线名 + 方向/闭环，不含任何编辑控件 -->
    <!-- 与建圈器同源的地图光学玻璃：受 GlassRenderGate 管控，共享同一次地图捕获 -->
    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/previewTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:elevation="6dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/previewMap"
        app:bevelWidth="10dp"
        app:cornerRadius="22dp"
        app:dispersionStrength="0.06"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="6dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/previewName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnPreviewEdit"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="编辑路线"
                    android:padding="9dp"
                    android:src="@drawable/ic_sliders"
                    app:tint="@color/pf_text_primary" />

                <ImageView
                    android:id="@+id/btnPreviewTestRun"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="试跑一圈"
                    android:padding="9dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/pf_text_primary" />

                <ImageView
                    android:id="@+id/btnPreviewClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="关闭"
                    android:padding="9dp"
                    android:src="@drawable/ic_xmark"
                    app:tint="@color/pf_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/previewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>

    <!-- 底部玻璃数据条：只读统计，不遮挡地图中心 -->
    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/previewStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:elevation="6dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/previewMap"
        app:bevelWidth="10dp"
        app:cornerRadius="20dp"
        app:dispersionStrength="0.06"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="6dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单圈"
                        android:textColor="@color/pf_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/statLap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/pf_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="轨迹点"
                        android:textColor="@color/pf_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/statPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/pf_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="来源"
                        android:textColor="@color/pf_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/statMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/pf_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 仪表级路书：海拔剖面 / 曲率急弯估算曲线 -->
            <com.zcshou.gogogo.run.ui.home.RouteElevationProfileView
                android:id="@+id/previewElevation"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>
</FrameLayout>
