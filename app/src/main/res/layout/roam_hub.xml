<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="8dp">

    <com.zcshou.gogogo.run.ui.overlay.CapsuleShellView
        android:id="@+id/hubPanel"
        android:layout_width="218dp"
        android:layout_height="258dp"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roamDragBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_more"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/dr_overlay_text_secondary"
                    android:gravity="center_vertical"
                    android:text="拖动位置"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/btnRoamHubLock"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_overlay_round"
                    android:contentDescription="摇杆锁定"
                    android:padding="7dp"
                    android:src="@drawable/ic_lock_open_line"
                    android:tint="@color/dr_overlay_text_secondary"
                    tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/btnRoamHubLocate"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_overlay_round"
                    android:contentDescription="回到当前位置"
                    android:padding="7dp"
                    android:src="@drawable/ic_crosshair"
                    android:tint="@color/dr_overlay_text_primary"
                    tools:ignore="UseAppTint" />

                <ImageView
                    android:id="@+id/btnRoamHubHide"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_overlay_round"
                    android:contentDescription="隐藏"
                    android:padding="7dp"
                    android:src="@drawable/ic_xmark"
                    android:tint="@color/dr_overlay_text_secondary"
                    tools:ignore="UseAppTint" />
            </LinearLayout>

            <com.zcshou.gogogo.run.ui.overlay.TacticalJoystickView
                android:id="@+id/roamHubJoystick"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" />

            <!-- 快捷飞跃地标条：默认折叠，展开时面板长高 32dp（见 RoamHubView.setQuickExpanded） -->
            <HorizontalScrollView
                android:id="@+id/roamQuickScroll"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/roamQuickRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overlay_tile"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/roamGearWalk"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="步"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/roamGearRun"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_overlay_chip_selected"
                    android:gravity="center"
                    android:text="跑"
                    android:textColor="@color/dr_overlay_ice"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/roamGearBike"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="骑"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/roamGearCar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="车"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/roamHubStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="待命 · 3.6 m/s"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnRoamQuickToggle"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_overlay_round"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/dr_overlay_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnRoamHubStop"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_overlay_danger_button"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="结束"
                    android:textColor="@color/dr_overlay_danger"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.overlay.CapsuleShellView>
</LinearLayout>
