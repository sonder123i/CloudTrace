<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 地图真正铺满四边：状态栏、导航栏下方都延伸到 -->
    <com.baidu.mapapi.map.TextureMapView
        android:id="@+id/roamMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 鲸鲸地图小人：屏幕空间 overlay，避开百度地图的暗夜反相 -->
    <com.zcshou.gogogo.mascot.MapMascotOverlayView
        android:id="@+id/mapMascot"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- 顶部 36dp 渐隐保护层：地图文字滚入状态栏时自然淡出 -->
    <View
        android:id="@+id/roamTopScrim"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim" />

    <!-- 顶部半透明磨砂玻璃搜索面板 -->
    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/roamTopPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:elevation="6dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/roamMap"
        app:bevelWidth="14dp"
        app:cornerRadius="24dp"
        app:dispersionStrength="0.10"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="8dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="5dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="搜索"
                android:src="@drawable/ic_search_line"
                app:tint="@color/pf_text_secondary" />

            <EditText
                android:id="@+id/roamSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="搜索地点，或粘贴 39.9,116.4"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:textColor="@color/pf_text_primary"
                android:textColorHint="@color/pf_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRoamSearch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="搜索"
                android:textColor="@color/pf_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@color/pf_stroke" />

            <ImageView
                android:id="@+id/btnRoamLocate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="定位到当前位置"
                android:padding="10dp"
                android:src="@drawable/ic_crosshair"
                app:tint="@color/pf_text_primary" />
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>

    <!-- 图层切换胶囊：暗夜 / 标准 / 卫星（卫星图不叠自定义暗色矩阵） -->
    <LinearLayout
        android:id="@+id/roamLayerBar"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_capsule"
        android:elevation="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/roamLayerDark"
            android:layout_width="42dp"
            android:layout_height="26dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="暗夜"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/roamLayerNormal"
            android:layout_width="42dp"
            android:layout_height="26dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="标准"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/roamLayerSat"
            android:layout_width="42dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="卫星"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 圆形玻璃定位按钮：真实折射地图内容，与顶部搜索面板同一材质 -->
    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/btnLocateMe"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="332dp"
        android:elevation="6dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/roamMap"
        app:bevelWidth="8dp"
        app:cornerRadius="23dp"
        app:dispersionStrength="0.06"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="5dp"
        app:sensorHighlight="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="定位到当前位置"
            android:padding="12dp"
            android:src="@drawable/ic_crosshair"
            app:tint="@color/pf_text_primary" />
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>

    <!-- 外层唯一背景，内层 TextView 不再自带背景，消除「内方外圆」叠影 -->
    <LinearLayout
        android:id="@+id/roamHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="322dp"
        android:background="@drawable/bg_capsule"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/roamHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:text="点按地图落点 · 显示悬浮摇杆"
            android:textColor="@color/pf_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 落点确认面板：与顶栏/控制台同源的地图光学玻璃（共享同一次捕获与刷新节拍） -->
    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/roamTargetBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="390dp"
        android:elevation="6dp"
        android:visibility="gone"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/roamMap"
        app:bevelWidth="10dp"
        app:cornerRadius="22dp"
        app:dispersionStrength="0.06"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="6dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/roamTargetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="目标 --, --"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoamTeleport"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="空降到此位置"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_location_line"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <TextView
                    android:id="@+id/btnRoamCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="取消"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>

    <!-- 底部磨砂玻璃漫游控制台 -->
    <com.zcshou.gogogo.run.ui.glass.CausticGlassView
        android:id="@+id/roamConsole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="82dp"
        android:elevation="8dp"
        app:adaptiveLensScale="true"
        app:backdropSourceId="@id/roamMap"
        app:bevelWidth="14dp"
        app:cornerRadius="24dp"
        app:dispersionStrength="0.10"
        app:glassMaterial="regular"
        app:glassTint="@color/dr_editor_optical_tint"
        app:refractionFalloff="2"
        app:refractionHeight="8dp"
        app:sensorHighlight="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="漫游控制台"
                    android:src="@drawable/ic_chart_line"
                    app:tint="@color/pf_text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:text="漫游控制台"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="实时遥测"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/btnRoamConsoleCollapse"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="收起控制台"
                    android:padding="8dp"
                    android:src="@drawable/ic_xmark"
                    app:tint="@color/pf_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/roamCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:singleLine="true"
                android:text="WGS --, -- · 漫游 0 m · 00:00 · 海拔 50 m · 未接管"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:id="@+id/roamFavScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/roamFavRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoamRecord"
                    style="@style/Widget.App.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:text="录制为路线"
                    app:icon="@drawable/ic_record_circle"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoamStar"
                    style="@style/Widget.App.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="收藏地点"
                    app:icon="@drawable/ic_star_line"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFollow"
                    style="@style/Widget.App.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="跟随中"
                    app:icon="@drawable/ic_location_line"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchSmoothWalk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="短距离平滑走过去（300m 内不瞬移）"
                android:textColor="@color/pf_text_primary"
                android:textSize="12sp"
        android:thumbTint="@color/pf_on_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoamStopSim"
                    style="@style/Widget.App.Button.CompactDanger"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="立即结束模拟"
                    app:icon="@drawable/ic_stop"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoamCollapsePanel"
                    style="@style/Widget.App.Button.Compact"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="收起面板"
                    app:icon="@drawable/ic_chevron_down"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>
        </LinearLayout>
    </com.zcshou.gogogo.run.ui.glass.CausticGlassView>

    <TextView
        android:id="@+id/roamConsoleChip"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_capsule"
        android:drawableStart="@drawable/ic_chart_line"
        android:drawablePadding="6dp"
        android:drawableTint="@color/pf_text_primary"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="漫游控制台"
        android:textColor="@color/pf_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
