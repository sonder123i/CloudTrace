<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Apple 无色空间底色：浅灰 / 纯黑 + 极柔中性环境光 -->
    <com.zcshou.gogogo.run.ui.overlay.BathymetricBackdropView
        android:id="@+id/homeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        clipToPadding=false + paddingBottom=128dp：
        内容可以自然滑入底部悬浮玻璃导航下方，产生真实模糊透视；
        「所有轨迹仅保存在本机」完整露出在导航栏上方。
        顶部/底部 inset 由 RouteListFragment 在运行时叠加。
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="124dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 大标题 + 路线数量 -->
            <!--
                elevation 8dp 的唯一目的：把这一行（连同鲸鲸角标里向下溢出的台词气泡）
                抬到下方 weekCard 玻璃条之上。本行没有 background，不会因此产生投影。
                删掉它气泡下半截会被玻璃条盖住，只剩一行字的上半部分。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="-0.02"
                    android:shadowColor="@color/dr_text_float_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/app_name"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/routeCountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_capsule"
                    android:fontFeatureSettings="tnum"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:shadowColor="@color/dr_text_float_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="0 条路线"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp" />

                <!-- 迷你鲸鲸角标：有路线时鲸鲸常驻这里（仅 FULL / LIGHT 显示） -->
                <com.zcshou.gogogo.mascot.MascotMiniBadgeView
                    android:id="@+id/homeMiniMascot"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 一行紧凑的玻璃信息条：本周累计 + 完成次数 + 战报入口 -->
            <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
                android:id="@+id/weekCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:elevation="0dp"
                app:lgBevelWidth="5dp"
                app:lgCaustics="false"
                app:lgCornerRadius="18dp"
                app:lgMatte="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本周"
                        android:textColor="@color/pf_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/weekKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:shadowColor="@color/dr_text_float_shadow"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="0.00 km"
                        android:textColor="@color/pf_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/pf_stroke" />

                    <TextView
                        android:id="@+id/weekCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:shadowColor="@color/dr_text_float_shadow"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="0 次"
                        android:textColor="@color/pf_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- 周目标迷你进度环：长按本卡片可改目标 -->
                    <com.zcshou.gogogo.run.ui.widget.WeeklyGoalRingView
                        android:id="@+id/weekGoalRing"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/weekStreakBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_capsule"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:textColor="@color/pf_text_secondary"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/pf_text_secondary"
                        android:gravity="center_vertical"
                        android:text="战报"
                        android:textColor="@color/pf_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

            <TextView
                android:id="@+id/setupBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hub_panel"
                android:drawableStart="@drawable/ic_shield_check"
                android:drawablePadding="8dp"
                android:drawableTint="@color/pf_text_primary"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="首次使用需完成 3 项基础授权 · 立即配置"
                android:textColor="@color/pf_bad"
                android:textSize="12sp"
                android:visibility="gone" />

            <!--
                我的路线：标题行只留纯标签，不再并排任何按钮 —— 11sp 的分区标题旁边
                压一颗 32dp 实心胶囊，会把整行撑高、上方留出一条空带，标题看起来像在
                为按钮让位。
                「导入口令」改成快选胶囊右端的固定小图标（细分隔线隔开，chips 在它左边
                滚动），既保留「可点」的实体感，又完全不额外占一条行高。
            -->
            <LinearLayout
                android:id="@+id/routeListHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:text="我的路线"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- V5.2 横向玻璃透镜轨道：外层高透长胶囊 + 内层弹簧选中透镜 -->
            <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
                android:id="@+id/routeChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:elevation="0dp"
                android:visibility="gone"
                app:lgBevelWidth="5dp"
                app:lgCaustics="false"
                app:lgCornerRadius="19dp"
                app:lgInteractive="false"
                app:lgLens="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:id="@+id/routeChipScrollView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/routeChipRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="4dp" />
                    </HorizontalScrollView>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="16dp"
                        android:background="@color/pf_panel_stroke" />

                    <FrameLayout
                        android:id="@+id/btnImportShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="导入口令"
                        android:focusable="true"
                        android:paddingStart="9dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_import"
                                app:tint="@color/pf_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="导入"
                                android:textColor="@color/pf_text_primary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

            <!-- 当前主路线卡（液态玻璃） -->
            <include
                android:id="@+id/routeMainCard"
                layout="@layout/item_route_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <!-- 空状态：首次建圈引导卡（无边框玻璃） -->
            <FrameLayout
                android:id="@+id/routeEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/homeMascotSpace"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hub_panel"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="20dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="84dp"
                    android:contentDescription="单色跑道线稿"
                    android:src="@drawable/ic_fish_track" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="还没有跑圈路线"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="新建一条操场路线，或导入好友发来的口令\n操场套模 · 自由手绘 · 路网贴合"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="12sp" />

                <com.zcshou.gogogo.run.ui.widget.SpecularButton
                    android:id="@+id/btnEmptyCreate"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:text="新建跑圈路线"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_plus"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyImport"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="从分享口令导入"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_import"
                    app:iconGravity="textStart"
                    app:iconPadding="7dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/pf_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="好友在路线卡点「分享口令」，把整段发给你即可"
                    android:textColor="@color/pf_text_tertiary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnEmptyUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="第一次用？看 30 秒上手 →"
                    android:textColor="@color/pf_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                </LinearLayout>
                </LinearLayout>

                <com.zcshou.gogogo.mascot.MascotPeekView
                    android:id="@+id/homeMascot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="3dp"
                    android:visibility="gone" />

                <com.zcshou.gogogo.mascot.MascotEggCardView
                    android:id="@+id/homeEggCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:elevation="5dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 路线工坊：无边框圆角玻璃卡片 -->
            <TextView
                android:id="@+id/routeWorkshopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.06"
                android:text="路线工坊"
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

            <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
                android:id="@+id/workshopCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:elevation="0dp"
                app:lgBevelWidth="5dp"
                app:lgCaustics="false"
                app:lgCornerRadius="22dp"
                app:lgMatte="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.62"
                        android:orientation="vertical">

                        <com.zcshou.gogogo.run.ui.widget.SpecularButton
                            android:id="@+id/btnNewRoute"
                            style="@style/Widget.App.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="新建跑圈路线"
                            android:textSize="15sp"
                            app:icon="@drawable/ic_plus"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="操场一键套模 / 校园自定义画线"
                            android:textColor="@color/pf_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="0.38"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickPreset"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:text="操场套模"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_stadium"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickFree"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="6dp"
                            android:text="自由手绘"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_pencil"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

            <!-- 支持云迹：常驻底部入口，不用等弹窗也能主动去赞赏 -->
            <com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer
                android:id="@+id/homeSupportCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:elevation="0dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:lgBevelWidth="5dp"
                app:lgCaustics="false"
                app:lgCornerRadius="18dp"
                app:lgMatte="true">

                <!--
                    这里不能加 clickable/focusable：内层一旦可点就会自己消费触摸事件，
                    父容器 homeSupportCard 的 OnClickListener 永远收不到，表现为「点了没反应」。
                    水波纹交给父容器的 foreground，整块卡片都是点击热区。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_heart_line"
                        app:tint="@color/pf_text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_support_title"
                            android:textColor="@color/pf_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_support_subtitle"
                            android:textColor="@color/pf_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/pf_text_tertiary" />
                </LinearLayout>
            </com.zcshou.gogogo.run.ui.glass.LiquidGlassContainer>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:text="所有轨迹仅保存在本机"
                android:textColor="@color/pf_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- iOS 26 Scroll Edge Effect：内容滚入状态栏时由清晰渐变到模糊（API 31+ GPU，低版本回退遮罩） -->
    <com.example.liquidglass.ScrollEdgeBlurView
        android:id="@+id/topEdgeBlur"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:visibility="invisible" />

    <!-- 轻量底色渐隐：压住状态栏图标的对比度，不再整条遮挡模糊 -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:alpha="0.55"
        android:background="@drawable/bg_top_scrim" />

</FrameLayout>
