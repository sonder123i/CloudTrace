<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <Switch
        android:id="@+id/swEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启用定时开跑"
        android:textColor="@color/pf_text_primary"
        android:textSize="15sp"
        android:thumbTint="@color/pf_on_primary" />

    <Switch
        android:id="@+id/swDaily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="每天执行（忽略重复日）"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp"
        android:thumbTint="@color/pf_on_primary" />

    <!-- 重复星期多选：bit0=周一 … bit6=周日；swDaily 开启时整行灰置 -->
    <TextView
        android:id="@+id/tvDayHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="重复星期（点选多天）"
        android:textColor="@color/pf_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/dayRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/day0"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="一"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day1"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="二"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day2"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="三"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day3"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="四"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day4"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="五"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day5"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="六"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/day6"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="日"
            android:textSize="13sp" />
    </LinearLayout>

    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:timePickerMode="spinner" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="随机延迟窗口（分钟，防每天分秒不差）"
        android:textColor="@color/pf_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etJitter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="8"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvLinkedApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="关联跑步 App：未选择（点击选择）"
        android:textColor="@color/pf_text_primary"
        android:textSize="13sp" />

    <Switch
        android:id="@+id/swWifiIsolate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开跑前提示关闭 Wi-Fi"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp"
        android:thumbTint="@color/pf_on_primary" />
</LinearLayout>