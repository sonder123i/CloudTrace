<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/updateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="应用更新"
        android:textColor="@color/pf_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/pf_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/pf_text_secondary"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="@color/pf_stroke"
        android:progressTint="@color/pf_volt"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updateSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/pf_text_tertiary"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updateForceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="此版本包含重要更新，请尽快安装"
        android:textColor="@color/pf_bad"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/updateNotesLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="本次更新"
        android:textColor="@color/pf_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <com.zcshou.gogogo.run.ui.widget.MaxHeightScrollView
        android:id="@+id/updateNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_recess"
        android:fillViewport="false"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/pf_text_primary"
            android:textSize="13sp" />
    </com.zcshou.gogogo.run.ui.widget.MaxHeightScrollView>

    <TextView
        android:id="@+id/updateCancelDownload"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="取消下载"
        android:textColor="@color/pf_bad"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
