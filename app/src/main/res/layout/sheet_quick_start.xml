<?xml version="1.0" encoding="utf-8"?>
<com.example.liquidglass.LiquidGlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:adaptiveLensScale="true"
    app:adaptiveTint="false"
    app:bevelWidth="14dp"
    app:cornerRadius="28dp"
    app:dispersionStrength="0.08"
    app:glassMaterial="regular"
    app:glassTint="@color/dr_card_optical_tint"
    app:refractionFalloff="2"
    app:refractionHeight="8dp"
    app:sensorHighlight="true">

    <!-- LiquidGlassView 是 FrameLayout：内容必须自己竖向排布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pf_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kmLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFeatureSettings="tnum"
        android:text="目标公里数：3.0 km"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seekKm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="95"
        android:progress="25"
        android:progressTint="@color/pf_volt"
        android:thumbTint="@color/pf_on_primary" />

    <TextView
        android:id="@+id/paceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFeatureSettings="tnum"
        android:text="目标配速：5'40&quot; /km"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seekPace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="48"
        android:progress="20"
        android:progressTint="@color/pf_volt"
        android:thumbTint="@color/pf_on_primary" />

    <!-- 配速策略：匀速 / 前慢后快 / 间歇变速 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="配速策略"
        android:textColor="@color/pf_text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/strategyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/strategy0"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="匀速"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/strategy1"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="前慢后快"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/strategy2"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_capsule"
            android:gravity="center"
            android:text="间歇变速"
            android:textSize="12sp" />
    </LinearLayout>

    <com.zcshou.gogogo.run.ui.widget.PaceStrategySparklineView
        android:id="@+id/strategySparkline"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvEta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:text="预计用时 17分05秒 · 约 18:47 完成"
        android:textColor="@color/pf_text_secondary"
        android:textSize="11sp" />

    <Switch
        android:id="@+id/switchDrift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="智能拟真浮动（每圈变道防重叠）"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp"
        android:thumbTint="@color/pf_on_primary" />

    <Switch
        android:id="@+id/switchReverse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="反向跑（与已保存方向相反）"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp"
        android:thumbTint="@color/pf_on_primary" />

    <Switch
        android:id="@+id/switchCooldown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="达标后慢走缓冲"
        android:textColor="@color/pf_text_primary"
        android:textSize="14sp"
        android:thumbTint="@color/pf_on_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="提示：免 Root 无法篡改硬件计步传感器，请随身携带手机走动或使用摇步器以同步步频。"
        android:textColor="@color/pf_text_secondary"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartRun"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="开始跑圈"
        android:textSize="14sp"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />
    </LinearLayout>
</com.example.liquidglass.LiquidGlassView>