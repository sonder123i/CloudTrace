<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 仅在使用地图「定位真实位置」时按需申请前台定位 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 网络与 Wi-Fi 状态（地图/联网；不含后台定位/扫描） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：下载完成后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 定时通知（首次开跑时按需申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 硬件计步守护（Android 10+ 监听 TYPE_STEP_COUNTER 需要） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 开机清理残留的模拟位置 test provider（进程被杀时不会走 onDestroy） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 可选 Shizuku 联动 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 悬浮控制胶囊（向导第一步） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 支持云迹：Android 9 及以下保存赞赏码到公共相册需要；10+ 走 MediaStore 不再申请 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 模拟位置应用（开发者选项内选择，不再读取设备识别码） -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />

    <!-- 关联跑步 App 选择器与系统安装器需要可见性（Android 11+ 包可见性） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <!-- 赞赏页保存后可以「打开微信」 -->
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:name=".GoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 路线数据含用户位置历史，禁止云备份/设备迁移导出 -->

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- 百度地图 间隔定位必须配置此service否则功能无效。
             SDK 可能以 startForeground 拉起该服务：targetSdk 34 起必须显式声明类型 -->
        <service
            android:name="com.baidu.location.f"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:process=":remote" />

        <service
            android:exported="false"
            android:name="com.zcshou.service.ServiceGo"
            android:foregroundServiceType="location" />

        <!-- run 模块 Phase 5：巡航会话前台服务（托管引擎，定时/后台可跑） -->
        <service
            android:name=".run.service.RunSessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- run 模块 V3.2：自由漫游前台服务（常驻悬浮摇杆，跨 App 可控） -->
        <service
            android:name=".run.service.RoamService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 应用更新：前台下载服务 -->
        <service
            android:name=".run.update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- run 模块 V3.4：下拉控制中心快捷磁贴 -->
        <service
            android:name=".run.service.DeepRunTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_cloudtrace"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- run 模块 Phase 5：定时闹钟广播 -->
        <receiver
            android:name=".run.guard.RunScheduleAlarmReceiver"
            android:exported="false" />

        <!-- 深海光学桌面小组件（4×1）：只读本机数据，开跑经 Activity 门控 -->
        <receiver
            android:name=".run.widget.CloudTraceWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cloudtrace_info" />
        </receiver>

        <!-- 只接收系统 protected broadcast；exported=false 同样能收到，且不暴露给第三方 -->
        <receiver
            android:name=".run.guard.RunScheduleBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 开机一次性清理残留 test provider：只清理，不拉起任何服务 -->
        <receiver
            android:name=".run.guard.TestProviderBootCleaner"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 可选 Shizuku 联动 Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.PaceFlow.Launch"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- run 模块：Phase 4 新版双 Tab 首页（欢迎页同意协议后进入；adb 调试入口放 debug 变体） -->
        <activity
            android:name=".run.ui.home.RunHomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PaceFlow.Launch" />

        <!-- run 模块：已保存路线详情预览 -->
        <activity
            android:name=".run.ui.home.RoutePreviewActivity"
            android:exported="false"
            android:label="路线预览"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- run 模块：关于页（唯一开源许可与致谢处） -->
        <activity
            android:name=".run.ui.home.AboutActivity"
            android:exported="false"
            android:label="关于"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- run 模块 V3.2：10 秒模拟跑圈预览（无需任何权限） -->
        <activity
            android:name=".run.ui.home.DemoPreviewActivity"
            android:exported="false"
            android:label="模拟预览"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- run 模块 V3.2：3 步新手配置向导 -->
        <activity
            android:name=".run.ui.home.SetupWizardActivity"
            android:exported="false"
            android:label="基础配置"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- 权限设置图文教程（真实截图 + 直达系统设置） -->
        <activity
            android:name=".run.ui.home.SetupGuideActivity"
            android:exported="false"
            android:label="权限图文教程"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- 功能使用指南（第一次跑的 4 步 + 其他功能） -->
        <activity
            android:name=".run.ui.home.UsageGuideActivity"
            android:exported="false"
            android:label="使用指南"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- 支持云迹：纯静态赞赏码页，不接支付 SDK -->
        <activity
            android:name=".run.ui.home.SupportActivity"
            android:exported="false"
            android:label="支持云迹"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- 问题反馈与诊断：本地生成诊断信息、分享日志、预填 GitHub Issue -->
        <activity
            android:name=".run.ui.home.FeedbackActivity"
            android:exported="false"
            android:label="问题反馈与诊断"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- 更新日志：渲染 assets/changelog.md -->
        <activity
            android:name=".run.ui.home.ChangelogActivity"
            android:exported="false"
            android:label="更新日志"
            android:theme="@style/Theme.PaceFlow.Light" />

        <!-- run 模块：Phase 2 引擎演示驱动页（Phase 4 由 RunHomeActivity 正式替代；adb 调试入口放 debug 变体） -->
        <activity
            android:name=".run.ui.home.RunEngineDemoActivity"
            android:exported="false"
            android:label="跑步引擎演示"
            android:theme="@style/AppTheme" />

        <!-- run 模块：Phase 3 无地图建圈编辑器（adb 调试入口放 debug 变体） -->
        <activity
            android:name=".run.ui.editor.RouteEditorActivity"
            android:exported="false"
            android:label="建圈器"
            android:theme="@style/Theme.PaceFlow.Light" />

    </application>

</manifest>